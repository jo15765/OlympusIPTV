<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#3A2F20"
                android:endColor="#251F17"
                android:type="linear" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="@color/focus" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="#33291C" />
            <corners android:radius="18dp" />
            <stroke android:width="1.5dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#322C23"
                android:endColor="#26211A"
                android:type="linear" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/stroke" />
        </shape>
    </item>
</selector>
