<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#3F3222"
                android:endColor="#251E15"
                android:type="linear" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/focus" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/accent_dim" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#231E18" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#3A3227" />
        </shape>
    </item>
</selector>
