<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#3A2F20"
                android:endColor="#241E16"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke
                android:width="2dp"
                android:color="@color/focus" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#8F622C"
                android:endColor="#6D4A20"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#2F2920"
                android:endColor="#242019"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/stroke" />
        </shape>
    </item>
</selector>
