<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/bg_fresh_focusable"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/miniGuideLogo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

            <TextView
                android:id="@+id/miniGuideName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/miniLiveBars"
                android:layout_width="16dp"
                android:layout_height="12dp"
                android:layout_marginTop="2dp"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:layout_width="3dp"
                    android:layout_height="5dp"
                    android:layout_marginEnd="2dp"
                    android:background="#FFE0B15A" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="2dp"
                    android:background="#FFE0B15A" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="7dp"
                    android:background="#FFE0B15A" />
            </LinearLayout>

        <TextView
            android:id="@+id/miniGuideShow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/miniGuideProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:max="1000"
            android:progressTint="#FFE0B15A" />
    </LinearLayout>

    <TextView
        android:id="@+id/miniGuideBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_search_pill"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:textColor="#FFE0B15A"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
