<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/remindBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_button"
            android:paddingHorizontal="22dp"
            android:nextFocusRight="@id/quietHours"
            android:nextFocusDown="@id/remindList"
            android:text="@string/back"
            android:textAllCaps="false"
            android:textColor="@color/bg"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/nav_reminders"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/quietHours"
            android:nextFocusLeft="@id/remindBack"
            android:nextFocusDown="@id/remindList"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_secondary"
            android:paddingHorizontal="18dp"
            android:text="@string/quiet_hours"
            android:textAllCaps="false"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/quietHoursHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/remindEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/remind_empty"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/remindList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:nextFocusUp="@id/remindBack"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />
</LinearLayout>
