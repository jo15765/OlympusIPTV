<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:paddingHorizontal="28dp"
    android:paddingTop="20dp">

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:background="@drawable/bg_nav"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:paddingHorizontal="18dp"
        android:nextFocusRight="@id/inputSearch"
        android:nextFocusDown="@id/resultGrid"
        android:text="@string/back"
        android:textColor="@color/nav_text"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/inputSearch"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_input"
        android:hint="@string/search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:nextFocusLeft="@id/btnBack"
        android:nextFocusRight="@id/btnVoice"
        android:nextFocusDown="@id/resultGrid"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        app:layout_constraintEnd_toStartOf="@id/btnVoice"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btnVoice"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_nav"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="64dp"
        android:paddingHorizontal="12dp"
        android:nextFocusLeft="@id/inputSearch"
        android:nextFocusRight="@id/btnSearch"
        android:nextFocusDown="@id/resultGrid"
        android:text="@string/search_voice_glyph"
        android:textColor="@color/accent"
        android:textSize="15sp"
        android:textStyle="bold"
        android:contentDescription="@string/search_voice"
        app:layout_constraintEnd_toStartOf="@id/btnSearch"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnSearch"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_button"
        android:focusable="true"
        android:minWidth="110dp"
        android:text="@string/search"
        android:textAllCaps="false"
        android:textColor="@color/bg"
        app:layout_constraintEnd_toStartOf="@id/btnHideKeyboard"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnHideKeyboard"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_button_secondary"
        android:focusable="true"
        android:minWidth="150dp"
        android:text="@string/hide_keyboard"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        app:layout_constraintEnd_toStartOf="@id/resultCount"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/resultCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/inputSearch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/inputSearch" />

    <HorizontalScrollView
        android:id="@+id/recentSearches"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/inputSearch">

        <LinearLayout
            android:id="@+id/recentSearchRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/search_prompt"
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recentSearches" />

    <LinearLayout
        android:id="@+id/nowPlayingBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_continue"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recentSearches">

        <androidx.media3.ui.PlayerView
            android:id="@+id/searchPreview"
            android:layout_width="128dp"
            android:layout_height="72dp"
            android:layout_marginEnd="10dp"
            android:focusable="false"
            android:visibility="gone"
            app:resize_mode="zoom"
            app:surface_type="texture_view"
            app:use_controller="false" />

        <TextView
            android:id="@+id/nowPlayingLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nowPlayingResume"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_button"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/now_playing_fullscreen"
            android:textColor="@color/bg"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/resultGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nowPlayingBar" />
</androidx.constraintlayout.widget.ConstraintLayout>
