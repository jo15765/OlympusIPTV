<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vpnPane"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:descendantFocusability="afterDescendants"
    android:fillViewport="true"
    android:focusable="false"
    android:scrollbars="none"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="16dp"
        android:paddingEnd="28dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/vpnBack"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_nav"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@id/vpnPia"
                android:nextFocusLeft="@id/btnAdmin"
                android:paddingHorizontal="14dp"
                android:text="@string/back"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/vpn_card"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/vpnStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/vpn_status_off"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/vpnPia"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="14dp"
                android:layout_weight="1"
                android:background="@drawable/bg_focusable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@id/vpnSurfshark"
                android:nextFocusLeft="@id/btnAdmin"
                android:nextFocusRight="@id/vpnProton"
                android:nextFocusUp="@id/vpnBack"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:focusable="false"
                    android:gravity="center"
                    android:text="@string/vpn_pia"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:focusable="false"
                    android:gravity="center"
                    android:text="@string/vpn_pia_detail"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/vpnProton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_focusable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@id/vpnNord"
                android:nextFocusLeft="@id/vpnPia"
                android:nextFocusUp="@id/vpnBack"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:gravity="center"
                    android:text="@string/vpn_proton"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:focusable="false"
                    android:gravity="center"
                    android:text="@string/vpn_proton_detail"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/vpnSurfshark"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="14dp"
                android:layout_weight="1"
                android:background="@drawable/bg_focusable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@id/vpnWireguard"
                android:nextFocusLeft="@id/btnAdmin"
                android:nextFocusRight="@id/vpnNord"
                android:nextFocusUp="@id/vpnPia"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:gravity="center"
                    android:text="@string/vpn_surf"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:focusable="false"
                    android:gravity="center"
                    android:text="@string/vpn_surf_detail"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/vpnNord"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_focusable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@id/vpnWireguard"
                android:nextFocusLeft="@id/vpnSurfshark"
                android:nextFocusUp="@id/vpnProton"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:gravity="center"
                    android:text="@string/vpn_nord"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:focusable="false"
                    android:gravity="center"
                    android:text="@string/vpn_nord_detail"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/vpnWireguard"
            android:layout_width="match_parent"
            android:layout_height="148dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_focusable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@id/btnAdmin"
            android:nextFocusUp="@id/vpnSurfshark"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:gravity="center"
                android:text="@string/vpn_wg"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:focusable="false"
                android:gravity="center"
                android:text="@string/vpn_wg_detail"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/vpnAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/vpnUser"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_field"
                android:hint="@string/vpn_user"
                android:inputType="text"
                android:nextFocusLeft="@id/btnAdmin"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <EditText
                android:id="@+id/vpnPass"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:hint="@string/vpn_pass"
                android:inputType="textPassword"
                android:nextFocusLeft="@id/btnAdmin"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <LinearLayout
                android:id="@+id/vpnCodeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/vpnCode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_field"
                    android:hint="@string/vpn_code"
                    android:inputType="number"
                    android:nextFocusLeft="@id/btnAdmin"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />
            </LinearLayout>

            <Button
                android:id="@+id/vpnAuth"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button"
                android:minWidth="160dp"
                android:nextFocusLeft="@id/btnAdmin"
                android:paddingHorizontal="22dp"
                android:text="@string/vpn_auth"
                android:textAllCaps="false"
                android:textColor="@color/bg"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/vpnConfigBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/vpn_wg_note"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/vpnConfig"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:gravity="top"
                android:hint="@string/vpn_config_hint"
                android:inputType="textMultiLine"
                android:nextFocusLeft="@id/btnAdmin"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/vpnCheck"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button"
                android:minWidth="160dp"
                android:nextFocusLeft="@id/btnAdmin"
                android:paddingHorizontal="22dp"
                android:text="@string/vpn_check"
                android:textAllCaps="false"
                android:textColor="@color/bg"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/vpnCityFind"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_field"
            android:hint="@string/vpn_find_city"
            android:inputType="text"
            android:nextFocusLeft="@id/btnAdmin"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/vpnCities"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:nextFocusLeft="@id/btnAdmin"
            android:visibility="gone" />

        <Button
            android:id="@+id/vpnConnect"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button"
            android:minWidth="160dp"
            android:nextFocusLeft="@id/btnAdmin"
            android:paddingHorizontal="22dp"
            android:text="@string/connect"
            android:textAllCaps="false"
            android:textColor="@color/bg"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/vpnBackup"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button"
            android:minWidth="160dp"
            android:nextFocusLeft="@id/btnAdmin"
            android:paddingHorizontal="22dp"
            android:text="@string/vpn_backup"
            android:textAllCaps="false"
            android:textColor="@color/bg"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
