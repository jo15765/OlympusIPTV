<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginBottom="0dp"
    android:descendantFocusability="afterDescendants"
    android:focusable="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/playTarget"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_menu_row"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center_vertical"
        android:nextFocusLeft="@id/categoryList"
        android:nextFocusRight="@+id/favorite"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="0dp">

        <TextView
            android:id="@+id/number"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:gravity="end"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_logo"
            android:contentDescription="@null"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_channel_placeholder" />

        <LinearLayout
            android:id="@+id/liveBars"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:visibility="gone">

            <View
                android:id="@+id/liveBar1"
                android:layout_width="3dp"
                android:layout_height="6dp"
                android:layout_marginEnd="2dp"
                android:background="#FFE0B15A" />

            <View
                android:id="@+id/liveBar2"
                android:layout_width="3dp"
                android:layout_height="12dp"
                android:layout_marginEnd="2dp"
                android:background="#FFE0B15A" />

            <View
                android:id="@+id/liveBar3"
                android:layout_width="3dp"
                android:layout_height="8dp"
                android:background="#FFE0B15A" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/country"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/group"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/epgNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/accent"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/favorite"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_nav"
        android:contentDescription="@string/search_favorite"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusLeft="@id/playTarget"
        android:nextFocusRight="@+id/record"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_star_outline" />

    <Button
        android:id="@+id/record"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_button_secondary"
        android:focusable="true"
        android:minWidth="72dp"
        android:nextFocusLeft="@id/favorite"
        android:nextFocusRight="@+id/moveUp"
        android:text="@string/record"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/moveUp"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_button_secondary"
        android:focusable="true"
        android:minWidth="52dp"
        android:nextFocusLeft="@id/favorite"
        android:nextFocusRight="@+id/moveDown"
        android:text="@string/lineup_up"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/moveDown"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_button_secondary"
        android:focusable="true"
        android:minWidth="64dp"
        android:nextFocusLeft="@id/moveUp"
        android:text="@string/lineup_down"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
