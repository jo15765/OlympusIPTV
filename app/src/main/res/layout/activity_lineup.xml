<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="18dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lineup_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/search"
            android:nextFocusDown="@id/tabLive"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/lineup_search"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <Button
            android:id="@+id/tabLive"
            android:nextFocusUp="@id/search"
            android:nextFocusRight="@id/tabVod"
            android:nextFocusDown="@id/groupList"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button"
            android:focusable="true"
            android:minWidth="90dp"
            android:text="@string/live"
            android:textAllCaps="false"
            android:textColor="@color/bg" />

        <Button
            android:id="@+id/tabVod"
            android:nextFocusLeft="@id/tabLive"
            android:nextFocusRight="@id/btnDone"
            android:nextFocusDown="@id/groupList"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_secondary"
            android:focusable="true"
            android:minWidth="90dp"
            android:text="@string/vod"
            android:textAllCaps="false"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnDone"
            android:nextFocusLeft="@id/tabVod"
            android:nextFocusDown="@id/groupList"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button"
            android:focusable="true"
            android:minWidth="90dp"
            android:text="@string/lineup_done"
            android:textAllCaps="false"
            android:textColor="@color/bg" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp"
                android:text="@string/groups"
                android:textAllCaps="true"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGroupsShow"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:focusable="true"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:singleLine="true"
                    android:text="@string/countries_all_button"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnGroupsHide"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:focusable="true"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:singleLine="true"
                    android:text="@string/countries_none"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnGroupsVisible"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:focusable="true"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:singleLine="true"
                    android:text="@string/filter_visible_short"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnGroupsHidden"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:focusable="true"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:singleLine="true"
                    android:text="@string/filter_hidden_short"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnGroupsBoth"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button"
                    android:focusable="true"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:singleLine="true"
                    android:text="@string/filter_both"
                    android:textAllCaps="false"
                    android:textColor="@color/bg"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnHideKeyboard"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1.3"
                    android:background="@drawable/bg_button_secondary"
                    android:focusable="true"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:singleLine="true"
                    android:text="@string/hide_keyboard"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/groupList"
                android:nextFocusUp="@id/tabLive"
                android:nextFocusRight="@id/channelList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="1.6"
            android:orientation="vertical">

            <TextView
                android:id="@+id/channelHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="@string/lineup_channels"
                android:textAllCaps="true"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channelList"
                android:nextFocusLeft="@id/groupList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
