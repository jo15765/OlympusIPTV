<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parentalRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clickable="true"
    android:focusable="false">

    <LinearLayout
        android:id="@+id/parentalContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_nav"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@id/btnBack"
                android:nextFocusDown="@id/btnSetPin"
                android:nextFocusLeft="@id/btnBack"
                android:nextFocusRight="@id/btnClearPin"
                android:paddingHorizontal="14dp"
                android:text="@string/back"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/parental_title"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSetPin"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@id/btnBack"
                android:nextFocusLeft="@id/btnSetPin"
                android:nextFocusRight="@id/btnClearPin"
                android:nextFocusDown="@id/groupList"
                android:paddingHorizontal="12dp"
                android:text="@string/parental_set_pin"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="15sp">
                <requestFocus />
            </TextView>

            <TextView
                android:id="@+id/btnClearPin"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusUp="@id/btnBack"
                android:nextFocusLeft="@id/btnSetPin"
                android:nextFocusRight="@id/btnClearPin"
                android:nextFocusDown="@id/groupList"
                android:paddingHorizontal="12dp"
                android:text="@string/parental_clear_pin"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/parentalHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/parental_hint"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/groupList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:nextFocusUp="@id/btnSetPin"
            android:nextFocusDown="@id/groupList"
            android:nextFocusLeft="@id/groupList"
            android:nextFocusRight="@id/groupList" />
    </LinearLayout>

    <View
        android:id="@+id/pinScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC141210"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/groupPin"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_panel"
        android:clickable="true"
        android:descendantFocusability="afterDescendants"
        android:elevation="18dp"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/groupPinTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:gravity="center"
            android:text="@string/group_pin_set"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/groupPinDigits"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="14dp"
            android:background="@color/bg_elevated"
            android:focusable="false"
            android:gravity="center"
            android:letterSpacing="0.35"
            android:text="––––"
            android:textColor="@color/text_primary"
            android:textSize="34sp" />

        <GridLayout
            android:id="@+id/pinPad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:descendantFocusability="afterDescendants"
            android:rowCount="4"
            android:useDefaultMargins="true">

            <TextView android:id="@+id/pin1" style="@style/OlympusIptvPinKey" android:text="1" />
            <TextView android:id="@+id/pin2" style="@style/OlympusIptvPinKey" android:text="2" />
            <TextView android:id="@+id/pin3" style="@style/OlympusIptvPinKey" android:text="3" />
            <TextView android:id="@+id/pin4" style="@style/OlympusIptvPinKey" android:text="4" />
            <TextView android:id="@+id/pin5" style="@style/OlympusIptvPinKey" android:text="5" />
            <TextView android:id="@+id/pin6" style="@style/OlympusIptvPinKey" android:text="6" />
            <TextView android:id="@+id/pin7" style="@style/OlympusIptvPinKey" android:text="7" />
            <TextView android:id="@+id/pin8" style="@style/OlympusIptvPinKey" android:text="8" />
            <TextView android:id="@+id/pin9" style="@style/OlympusIptvPinKey" android:text="9" />
            <TextView android:id="@+id/pinClearDigit" style="@style/OlympusIptvPinKey" android:text="⌫" />
            <TextView android:id="@+id/pin0" style="@style/OlympusIptvPinKey" android:text="0" />
            <TextView android:id="@+id/pinCancel" style="@style/OlympusIptvPinKey" android:text="@string/group_pin_cancel" />
        </GridLayout>

        <TextView
            android:id="@+id/pinOk"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/group_pin_wrong_ok"
            android:textColor="@color/bg"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
