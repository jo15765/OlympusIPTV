<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/libraryBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_nav"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/mobile_back"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/library_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/libraryPills"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pillQueue"
            style="@style/OlympusIptvNavItem"
            android:layout_width="wrap_content"
            android:layout_marginEnd="8dp"
            android:minWidth="120dp"
            android:nextFocusDown="@id/libraryHost"
            android:text="@string/nav_queue" />

        <TextView
            android:id="@+id/pillFresh"
            style="@style/OlympusIptvNavItem"
            android:layout_width="wrap_content"
            android:layout_marginEnd="8dp"
            android:minWidth="120dp"
            android:nextFocusDown="@id/libraryHost"
            android:text="@string/nav_fresh" />

        <TextView
            android:id="@+id/pillReminders"
            style="@style/OlympusIptvNavItem"
            android:layout_width="wrap_content"
            android:minWidth="120dp"
            android:nextFocusDown="@id/libraryHost"
            android:text="@string/nav_reminders" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/libraryHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:descendantFocusability="afterDescendants"
        android:nextFocusUp="@id/libraryPills" />
</LinearLayout>
