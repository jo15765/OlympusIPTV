<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingHorizontal="36dp"
    android:paddingTop="24dp">

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@drawable/bg_nav"
        android:focusable="true"
        android:gravity="center"
        android:paddingHorizontal="18dp"
        android:nextFocusDown="@id/host"
        android:text="@string/back"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/record_share_title"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/host"
        android:nextFocusUp="@id/btnBack"
        android:nextFocusDown="@id/share"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input"
        android:hint="@string/record_share_host"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary" />

    <EditText
        android:id="@+id/share"
        android:nextFocusUp="@id/host"
        android:nextFocusDown="@id/folder"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:hint="@string/record_share_name"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary" />

    <EditText
        android:id="@+id/folder"
        android:nextFocusUp="@id/share"
        android:nextFocusDown="@id/username"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:hint="@string/record_share_folder"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary" />

    <EditText
        android:id="@+id/username"
        android:nextFocusUp="@id/folder"
        android:nextFocusDown="@id/password"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:hint="@string/record_share_user"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary" />

    <EditText
        android:id="@+id/password"
        android:nextFocusUp="@id/username"
        android:nextFocusDown="@id/save"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:hint="@string/record_share_pass"
        android:inputType="textPassword"
        android:paddingHorizontal="16dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary" />

    <Button
        android:id="@+id/save"
        android:nextFocusUp="@id/password"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button"
        android:text="@string/save"
        android:textAllCaps="false"
        android:textColor="@color/bg" />
</LinearLayout>
