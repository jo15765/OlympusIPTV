# ==============================================================================
# ClearCast Tuner / Olympus-IPTV — Cloud API & Worker Environment Template
# Copy this file to .env and fill in your own PostgreSQL & security values.
# NEVER commit your real .env file to Git!
# ==============================================================================

# --- PostgreSQL Connection ---
# Option 1: Individual connection parameters (works with CloudClusters, Neon,
# Supabase, AWS RDS, or the optional local Docker Postgres profile).
PGHOST=your-postgres-host.example.com
PGPORT=5432
PGDATABASE=clearcast_iptv
PGUSER=postgres
PGPASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# Use "require" for managed cloud Postgres, or "disable" for local Docker Postgres
PGSSLMODE=require

# Option 2: Or provide a single connection string instead of PGHOST/PGPORT/...
# DATABASE_URL=postgresql://postgres:CHANGE_ME@your-postgres-host.example.com:5432/clearcast_iptv

# --- Encryption & API Security ---
# 32-byte hex key for AES-256-GCM encryption of IPTV credentials at rest.
# Generate with: openssl rand -hex 32
CREDENTIALS_KEY=CHANGE_ME_64_HEX_CHARS

# Optional shared API key sent via X-Olympus-Api-Key header on /api/* requests.
# Leave blank to allow unauthenticated LAN/app requests, or set a strong random value.
API_SECRET_KEY=

# Require cryptographic X-Device-Token verification on device endpoints (true/false)
STRICT_DEVICE_TOKENS=false

# --- Server & Reverse Proxy Settings ---
PORT=3000
BIND_HOST=127.0.0.1
PUBLISH_PORT=8443
# Allowed CORS origin(s), e.g. https://your-domain.example.com (or * for native apps)
CORS_ORIGIN=*
# Number of reverse proxy hops in front of the container (1 = Nginx/Caddy, 2 = Cloudflare + Proxy)
TRUST_PROXY=1

# WAN static web dashboard is disabled by default (the LAN dashboard lives inside the Android app).
# Set to true only if you intentionally want to expose a web UI on WAN.
ENABLE_WEB_DASHBOARD=false

# --- Optional Advanced Tuner & Proxy Features (All OFF by default) ---
# HDHomeRun Virtual Tuner Emulation for Plex / Jellyfin / Emby (/discover.json, /lineup.json)
ENABLE_HDHR=false
HDHR_DEVICE_ID=CC202601
HDHR_TUNER_COUNT=4
HDHR_ACCOUNT_EMAIL=
HDHR_DEVICE_CODE=__shared__

# Shared Stream Proxy / Connection Deduplication (1 upstream connection fanned out to multiple TVs)
ENABLE_STREAM_PROXY=false

# Optional Gluetun VPN Sidecar (activate with: docker compose --profile vpn up -d)
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
VPN_SERVER_COUNTRIES=United States
